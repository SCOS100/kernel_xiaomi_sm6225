			compatible = "qcom,msm-pcm-afe";
			phandle = <0x1b1>;
		};

		pcm_noirq: qcom,msm-pcm-dsp-noirq {
			compatible = "qcom,msm-pcm-dsp-noirq";
			phandle = <0x1b5>;
			qcom,latency-level = "ultra";
