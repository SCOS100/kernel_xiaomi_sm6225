			glink_adsp: adsp {
				interrupts = <0x00 0x115 0x01>;
				label = "adsp";
				mbox-names = "adsp_smem";
				mboxes = <&apcs_glb 0x08>;
				phandle = <0xdd>;
				qcom,glink-label = "lpass";
				qcom,remote-pid = <0x02>;
				transport = "smem";

				qcom,adsp_glink_ssr {
					qcom,glink-channels = "glink_ssr";
					qcom,notify-edges = <&glink_modem>, <&glink_cdsp>;
