			qcom,allowed-clock-rates = <0x7f27450 0xe4e1c00 0x11e1a300 0x16e36000>;
			qcom,clock-configs = <0x01 0x00 0x00 0x01 0x00 0x00>;
			qcom,clock-freq-threshold = <0x11e1a300>;
