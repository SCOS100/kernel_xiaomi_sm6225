		usb0: ssusb@4e00000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			USB3_GDSC-supply = <&gcc_usb30_prim_gdsc>;
			clock-names = "core_clk", "iface_clk", "bus_aggr_clk", "xo", "sleep_clk", "utmi_clk";
			clocks = <&gcc 0x8f>, <&gcc 0x81>, <&gcc 0x47>, <&gcc 0x95>, <&gcc 0x94>, <&gcc 0x91>;
			compatible = "qcom,dwc-usb3-msm";
			dpdm-supply = <&usb2_phy0>;
			interrupt-names = "pwr_event_irq", "ss_phy_irq", "dp_hs_phy_irq", "dm_hs_phy_irq";
			interrupts = <0x00 0x12e 0x04>, <0x00 0x1a6 0x04>, <0x00 0xb8 0x01>, <0x00 0xbc 0x01>;
			iommus = <&apps_smmu 0x120 0x00>;
			qcom,core-clk-rate = <0x7f28155>;
			qcom,core-clk-rate-hs = <0x3f940ab>;
			qcom,dwc-usb3-msm-tx-fifo-size = <0x5328>;
			qcom,gsi-disable-io-coherency;
			qcom,gsi-reg-offset = <0xfc 0x110 0x120 0x130 0x144 0x1a4>;
			qcom,iommu-dma = "atomic";
			qcom,iommu-dma-addr-pool = <0x50000000 0x60000000>;
			qcom,msm-bus,name = "usb0";
			qcom,msm-bus,num-cases = <0x04>;
			qcom,msm-bus,num-paths = <0x03>;
			qcom,msm-bus,vectors-KBps = <0x3d 0x200 0x00 0x00>, <0x3d 0x2a4 0x00 0x00>, <0x01 0x247 0x00 0x00>, <0x3d 0x200 0x3a980 0xaae60>, <0x3d 0x2a4 0x00 0x960>, <0x01 0x247 0x00 0x9c40>, <0x3d 0x200 0x3a980 0xaae60>, <0x3d 0x2a4 0x00 0x960>, <0x01 0x247 0x00 0x9c40>, <0x3d 0x200 0x01 0x01>, <0x3d 0x2a4 0x01 0x01>, <0x01 0x247 0x01 0x01>;
			qcom,num-gsi-evt-buffs = <0x03>;
			ranges;
			reg = <0x4e00000 0x100000>;
			reg-names = "core_base";
			reset-names = "core_reset";
			resets = <&gcc 0x05>;

			dwc3@4e00000 {
				compatible = "snps,dwc3";
				dr_mode = "peripheral";
				interrupt-parent = <&intc>;
				interrupts = <0x00 0xff 0x04>;
				linux,sysdev_is_parent;
				maximum-speed = "super-speed";
				reg = <0x4e00000 0xe000>;
				snps,disable-clk-gating;
				snps,has-lpm-erratum;
				snps,hird-threshold = [10];
				snps,usb3-u1u2-disable;
				snps,usb3_lpm_capable;
				tx-fifo-resize;
				usb-core-id = <0x00>;
				usb-phy = <&usb2_phy0>, <&usb_qmp_dp_phy>;
			};

			qcom,usbbam@0x04f04000 {
				compatible = "qcom,usb-bam-msm";
				interrupts = <0x00 0xfd 0x04>;
				qcom,disable-clk-gating;
				qcom,reset-bam-on-connect;
				qcom,usb-bam-fifo-baseaddr = <0xc121000>;
				qcom,usb-bam-max-mbps-highspeed = <0x190>;
				qcom,usb-bam-max-mbps-superspeed = <0xe10>;
				qcom,usb-bam-num-pipes = <0x04>;
				qcom,usb-bam-override-threshold = <0x4001>;
				reg = <0x4f04000 0x17000>;

				qcom,pipe0 {
					label = "ssusb-qdss-in-0";
					qcom,data-fifo-offset = <0x00>;
					qcom,data-fifo-size = <0x1800>;
					qcom,descriptor-fifo-offset = <0x1800>;
					qcom,descriptor-fifo-size = <0x800>;
					qcom,dir = <0x01>;
					qcom,dst-bam-pipe-index = <0x00>;
					qcom,peer-bam = <0x00>;
					qcom,peer-bam-physical-address = <0x8064000>;
					qcom,pipe-num = <0x00>;
					qcom,src-bam-pipe-index = <0x00>;
					qcom,usb-bam-mem-type = <0x02>;
				};
			};
		};

		stm: stm@8002000 {
			arm,primecell-periphid = <0xbb962>;
			clock-names = "apb_pclk";
			clocks = <&rpmcc 0x08>;
			compatible = "arm,primecell";
			coresight-name = "coresight-stm";
			nvmem-cell-names = "debug_fuse";
			nvmem-cells = <&stm_debug_fuse>;
			reg = <0x8002000 0x1000>, <0xe280000 0x180000>;
			reg-names = "stm-base", "stm-stimulus-base";

			port {

				stm_out_funnel_in0: endpoint {
					phandle = <0x5a>;
					remote-endpoint = <&funnel_in0_in_stm>;
				};
			};
		};

		suspendable_ddr4_bw_opp_table: suspendable-ddr4-bw-opp-table {
			compatible = "operating-points-v2";

			opp-0 {
				opp-hz = /bits/ 64 <0x00>;
				opp-supported-hw = <0x80>;
			};

			opp-1017 {
				opp-hz = /bits/ 64 <0x1e4f>;
				opp-supported-hw = <0x80>;
			};

			opp-1555 {
				opp-hz = /bits/ 64 <0x2e57>;
				opp-supported-hw = <0x80>;
			};

			opp-1804 {
				opp-hz = /bits/ 64 <0x35c3>;
				opp-supported-hw = <0x80>;
			};

			opp-200 {
				opp-hz = /bits/ 64 <0x5f5>;
				opp-supported-hw = <0x80>;
			};

			opp-2092 {
				opp-hz = /bits/ 64 <0x3e58>;
				opp-supported-hw = <0x80>;
			};

			opp-547 {
				opp-hz = /bits/ 64 <0x104d>;
				opp-supported-hw = <0x80>;
			};

			opp-768 {
				opp-hz = /bits/ 64 <0x16e3>;
				opp-supported-hw = <0x80>;
			};
		};

