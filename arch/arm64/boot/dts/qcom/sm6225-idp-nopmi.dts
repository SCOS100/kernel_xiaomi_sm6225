		ddr_bw_opp_table: ddr-bw-opp-table {
			compatible = "operating-points-v2";
			phandle = <0xee>;

			opp-1017 {
				opp-hz = /bits/ 64 <0x1e4f>;
				opp-supported-hw = <0x80>;
			};

			opp-1555 {
				opp-hz = /bits/ 64 <0x2e57>;
				opp-supported-hw = <0x80>;
			};

			opp-1804 {
				opp-hz = /bits/ 64 <0x35c3>;
				opp-supported-hw = <0x80>;
			};

			opp-200 {
				opp-hz = /bits/ 64 <0x5f5>;
				opp-supported-hw = <0x80>;
			};

			opp-2092 {
				opp-hz = /bits/ 64 <0x3e58>;
				opp-supported-hw = <0x80>;
			};

			opp-547 {
				opp-hz = /bits/ 64 <0x104d>;
				opp-supported-hw = <0x80>;
			};

			opp-768 {
				opp-hz = /bits/ 64 <0x16e3>;
				opp-supported-hw = <0x80>;
			};
		};

