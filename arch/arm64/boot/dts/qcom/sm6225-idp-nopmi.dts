		pil_gpu: qcom,kgsl-hyp {
			compatible = "qcom,pil-tz-generic";
			qcom,firmware-name = "a610_zap";
			qcom,mas-crypto = <&mas_crypto_c0>;
			qcom,pas-id = <0x0d>;
		};

		kgsl_msm_iommu: qcom,kgsl-iommu@59a0000 {
			clock-names = "mem_clk", "mem_iface_clk", "smmu_vote";
			clocks = <&gcc 0x12>, <&gcc 0x5a>, <&gpucc 0x0e>;
			compatible = "qcom,kgsl-smmu-v2";
			qcom,hyp_secure_alloc;
			qcom,protect = <0xa0000 0x10000>;
			qcom,retention;
			reg = <0x59a0000 0x10000>;

			gfx3d_secure: gfx3d_secure {
				compatible = "qcom,smmu-kgsl-cb";
				iommus = <&kgsl_smmu 0x02 0x00>;
				label = "gfx3d_secure";
				qcom,iommu-dma = "disabled";
			};

			gfx3d_user: gfx3d_user {
				compatible = "qcom,smmu-kgsl-cb";
				iommus = <&kgsl_smmu 0x00 0x01>;
				label = "gfx3d_user";
				qcom,gpu-offset = <0xa8000>;
				qcom,iommu-dma = "disabled";
			};
		};

		lmh_cpu_vdd: qcom,lmh-cpu-vdd@f550800 {
			#cooling-cells = <0x02>;
			compatible = "qcom,lmh-cpu-vdd";
			phandle = <0xbd>;
			reg = <0xf550800 0x1000>;
		};

		qcom,lpass@ab00000 {
			clock-names = "xo";
			clocks = <&rpmcc 0x8f>;
			compatible = "qcom,pil-tz-generic";
			interrupt-names = "qcom,wdog", "qcom,err-fatal", "qcom,proxy-unvote", "qcom,err-ready", "qcom,stop-ack";
			interrupts-extended = <&intc 0x00 0x11a 0x01>, <&adsp_smp2p_in 0x00 0x00>, <&adsp_smp2p_in 0x02 0x00>, <&adsp_smp2p_in 0x01 0x00>, <&adsp_smp2p_in 0x03 0x00>;
			memory-region = <&pil_adsp_mem>;
			qcom,complete-ramdump;
			qcom,firmware-name = "adsp";
			qcom,mas-crypto = <&mas_crypto_c0>;
			qcom,minidump-as-elf32;
			qcom,minidump-id = <0x05>;
			qcom,pas-id = <0x01>;
			qcom,proxy-clock-names = "xo";
			qcom,proxy-reg-names = "vdd_lpi_cx", "vdd_lpi_mx";
			qcom,proxy-timeout-ms = <0x2710>;
			qcom,smem-id = <0x1a7>;
			qcom,smem-state-names = "qcom,force-stop";
			qcom,smem-states = <&adsp_smp2p_out 0x00>;
			qcom,ssctl-instance-id = <0x14>;
			qcom,sysmon-id = <0x01>;
			qcom,vdd_lpi_cx-uV-uA = <0x180 0x00>;
			qcom,vdd_lpi_mx-uV-uA = <0x180 0x00>;
			reg = <0xab00000 0x100>;
			vdd_lpi_cx-supply = <&L3A_LEVEL>;
			vdd_lpi_mx-supply = <&L2A_LEVEL>;
		};

		qcom,lpm-levels {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "qcom,lpm-levels";
			qcom,use-psci;

			qcom,pm-cluster@0 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				label = "system";
				qcom,psci-mode-mask = <0x0f>;
				qcom,psci-mode-shift = <0x08>;
				qcom,spm-device-names = "cci";
				reg = <0x00>;

				qcom,pm-cluster-level@0 {
					label = "system-wfi";
					qcom,entry-latency-us = <0x280>;
					qcom,exit-latency-us = <0x676>;
					qcom,min-residency-us = <0x8f6>;
					qcom,psci-mode = <0x00>;
					reg = <0x00>;
				};

				qcom,pm-cluster-level@1 {
					label = "system-pc";
					qcom,entry-latency-us = <0x2a4f>;
					qcom,exit-latency-us = <0x119a>;
					qcom,is-reset;
					qcom,min-child-idx = <0x02>;
					qcom,min-residency-us = <0x3bea>;
					qcom,notify-rpm;
					qcom,psci-mode = <0x03>;
					reg = <0x01>;
				};

				qcom,pm-cluster@0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					label = "pwr";
					qcom,psci-mode-mask = <0x0f>;
					qcom,psci-mode-shift = <0x04>;
					qcom,spm-device-names = "l2";
					reg = <0x00>;

					qcom,pm-cluster-level@0 {
						label = "pwr-l2-wfi";
						qcom,entry-latency-us = <0x26>;
						qcom,exit-latency-us = <0x33>;
						qcom,min-residency-us = <0x59>;
						qcom,psci-mode = <0x01>;
						reg = <0x00>;
					};

					qcom,pm-cluster-level@1 {
						label = "pwr-l2-gdhs";
						qcom,entry-latency-us = <0x168>;
						qcom,exit-latency-us = <0x1a5>;
						qcom,min-child-idx = <0x01>;
						qcom,min-residency-us = <0x30e>;
						qcom,psci-mode = <0x02>;
						reg = <0x01>;
					};

					qcom,pm-cluster-level@2 {
						label = "pwr-l2-pc";
						qcom,entry-latency-us = <0x320>;
						qcom,exit-latency-us = <0x846>;
						qcom,is-reset;
						qcom,min-child-idx = <0x01>;
						qcom,min-residency-us = <0x1cd0>;
						qcom,psci-mode = <0x04>;
						reg = <0x02>;
					};

					qcom,pm-cpu {
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						qcom,cpu = <&CPU0&CPU1&CPU2&CPU3>;
						qcom,disable-ipi-prediction;
						qcom,psci-mode-mask = <0x0f>;
						qcom,psci-mode-shift = <0x00>;

						qcom,pm-cpu-level@0 {
							label = "wfi";
							qcom,entry-latency-us = <0x31>;
							qcom,exit-latency-us = <0x2a>;
							qcom,min-residency-us = <0x5b>;
							qcom,psci-cpu-mode = <0x01>;
							reg = <0x00>;
						};

						qcom,pm-cpu-level@1 {
							label = "pc";
							qcom,entry-latency-us = <0x122>;
