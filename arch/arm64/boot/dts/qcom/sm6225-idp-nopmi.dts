		goodix_fp {
			compatible = "goodix,fingerprint";
			fp-gpio-irq = <&tlmm 0x53 0x00>;
			fp-gpio-pwr = <&tlmm 0x64 0x00>;
			fp-gpio-reset = <&tlmm 0x68 0x00>;
			interrupt = <0x53 0x00>;
			interrupt-parent = <&tlmm>;
			pinctrl-0 = <&msm_gpio_104>;
			pinctrl-1 = <&msm_gpio_104_output_high>;
			pinctrl-2 = <&msm_gpio_100>;
			pinctrl-3 = <&msm_gpio_100_output_high>;
			pinctrl-names = "goodix_reset_outputlow", "goodix_reset_outputhigh", "goodix_pwr_outputlow", "goodix_pwr_outputhigh";
			status = "okay";
			vcc_ana_supply = <&pm6125_l9>;
			vcc_spi_supply = <&pm6125_l9>;
			vdd_io-supply = <&pm6125_l9>;
		};

		gpio_keys {
			compatible = "gpio-keys";
			label = "gpio-keys";
			pinctrl-0 = <&key_vol_up_default>;
			pinctrl-names = "default";

			vol_up {
				debounce-interval = <0x0f>;
				gpio-key,wakeup;
				gpios = <&pm6125_gpios 0x05 0x01>;
				label = "volume_up";
				linux,can-disable;
				linux,code = <0x73>;
				linux,input-type = <0x01>;
			};
		};

		gpu_bw_tbl: gpu-bw-tbl {
			compatible = "operating-points-v2";
			phandle = <0x181>;

			opp-0 {
				opp-hz = /bits/ 64 <0x00>;
			};

			opp-100 {
				opp-hz = /bits/ 64 <0x2fa>;
			};

			opp-1017 {
				opp-hz = /bits/ 64 <0x1e4f>;
			};

			opp-1353 {
				opp-hz = /bits/ 64 <0x2852>;
			};

			opp-1555 {
				opp-hz = /bits/ 64 <0x2e57>;
			};

			opp-1804 {
				opp-hz = /bits/ 64 <0x35c3>;
			};

			opp-200 {
				opp-hz = /bits/ 64 <0x5f5>;
			};

			opp-2092 {
				opp-hz = /bits/ 64 <0x3e58>;
			};

			opp-300 {
				opp-hz = /bits/ 64 <0x8f0>;
			};

			opp-451 {
				opp-hz = /bits/ 64 <0xd70>;
			};

			opp-547 {
				opp-hz = /bits/ 64 <0x104d>;
			};

			opp-681 {
				opp-hz = /bits/ 64 <0x144b>;
			};

			opp-768 {
				opp-hz = /bits/ 64 <0x16e3>;
			};
		};

		gpu_opp_table: gpu-opp-table {
			compatible = "operating-points-v2";
			phandle = <0x180>;

			opp-1025000000 {
				opp-hz = /bits/ 64 <0x3d184240>;
				opp-microvolt = <0x180>;
			};

			opp-1114800000 {
				opp-hz = /bits/ 64 <0x42727f80>;
				opp-microvolt = <0x1a0>;
			};

			opp-320000000 {
				opp-hz = /bits/ 64 <0x1312d000>;
				opp-microvolt = <0x40>;
			};

			opp-465000000 {
				opp-hz = /bits/ 64 <0x1bb75640>;
				opp-microvolt = <0x80>;
			};

			opp-600000000 {
				opp-hz = /bits/ 64 <0x23c34600>;
				opp-microvolt = <0xc0>;
			};

			opp-745000000 {
				opp-hz = /bits/ 64 <0x2c67cc40>;
				opp-microvolt = <0x100>;
			};

			opp-785000000 {
				opp-hz = /bits/ 64 <0x2eca2640>;
				opp-microvolt = <0x100>;
			};

			opp-820000000 {
				opp-hz = /bits/ 64 <0x30e03500>;
				opp-microvolt = <0x140>;
			};

			opp-900000000 {
				opp-hz = /bits/ 64 <0x35a4e900>;
				opp-microvolt = <0x180>;
			};

			opp-950000000 {
				opp-hz = /bits/ 64 <0x389fd980>;
				opp-microvolt = <0x1a0>;
			};

			opp-980000000 {
				opp-hz = /bits/ 64 <0x3a699d00>;
				opp-microvolt = <0x1a0>;
			};
		};

		usb2_phy0: hsphy@1613000 {
			clock-names = "ref_clk_src", "cfg_ahb_clk";
			clocks = <&rpmcc 0x8a>, <&gcc 0x11>;
			compatible = "qcom,usb-hsphy-snps-femto";
			phandle = <0x104>;
			qcom,param-override-seq = <0x61 0x6c>, <0x08 0x70>, <0x2d 0x74>;
			qcom,param-override-seq-no-panel = <0x61 0x6c>, <0x83 0x70>, <0x2d 0x74>;
			qcom,vdd-voltage-level = <0x00 0xd6d80 0xd6d80>;
			reg = <0x1613000 0x110>, <0x1612000 0x04>;
			reg-names = "hsusb_phy_base", "eud_enable_reg";
			reset-names = "phy_reset";
			resets = <&gcc 0x00>;
			vdd-supply = <&L4A>;
			vdda18-supply = <&L12A>;
			vdda33-supply = <&L15A>;
		};

		hwevent {
			clock-names = "apb_pclk";
			clocks = <&rpmcc 0x08>;
			compatible = "qcom,coresight-hwevent";
			coresight-csr = <&csr>;
			coresight-name = "coresight-hwevent";
		};

		tcsr_mutex: hwlock {
			#hwlock-cells = <0x01>;
			compatible = "qcom,tcsr-mutex";
			phandle = <0xd8>;
			syscon = <&tcsr_mutex_block 0x00 0x1000>;
		};

		qupv3_se0_i2c: i2c@4a80000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-names = "se-clk", "m-ahb", "s-ahb";
			clocks = <&gcc 0x69>, <&gcc 0x75>, <&gcc 0x76>;
			compatible = "qcom,i2c-geni";
			dma-names = "tx", "rx";
			dmas = <&gpi_dma0 0x00 0x00 0x03 0x40 0x00>, <&gpi_dma0 0x01 0x00 0x03 0x40 0x00>;
			interrupts = <0x00 0x147 0x04>;
			pinctrl-0 = <&qupv3_se0_i2c_active>;
			pinctrl-1 = <&qupv3_se0_i2c_sleep>;
			pinctrl-names = "default", "sleep";
			qcom,wrapper-core = <&qupv3_0>;
			reg = <0x4a80000 0x4000>;
			status = "disabled";
		};

		qupv3_se1_i2c: i2c@4a84000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-names = "se-clk", "m-ahb", "s-ahb";
			clocks = <&gcc 0x6b>, <&gcc 0x75>, <&gcc 0x76>;
			compatible = "qcom,i2c-geni";
			dma-names = "tx", "rx";
			dmas = <&gpi_dma0 0x00 0x01 0x03 0x40 0x00>, <&gpi_dma0 0x01 0x01 0x03 0x40 0x00>;
			interrupts = <0x00 0x148 0x04>;
			pinctrl-0 = <&qupv3_se1_i2c_active>;
			pinctrl-1 = <&qupv3_se1_i2c_sleep>;
			pinctrl-names = "default", "sleep";
			qcom,wrapper-core = <&qupv3_0>;
			reg = <0x4a84000 0x4000>;
			status = "ok";

			aw87xxx_pa_58@58 {
				compatible = "awinic,aw87xxx_pa";
				dev_index = <0x01>;
				reg = <0x58>;
				reset-gpio = <&tlmm 0x6a 0x00>;
				status = "okay";
			};

			aw87xxx_pa_5B@5B {
				compatible = "awinic,aw87xxx_pa";
				dev_index = <0x00>;
				reg = <0x5b>;
				reset-gpio = <&tlmm 0x23 0x00>;
				status = "okay";
			};

			awinic@64 {
				compatible = "awinic,aw2016_led";
				reg = <0x64>;

				awinic,blue {
					awinic,fall-time-ms = <0x06>;
					awinic,hold-time-ms = <0x00>;
					awinic,id = <0x02>;
					awinic,imax = <0x02>;
					awinic,led-current = <0x03>;
					awinic,max-brightness = <0xff>;
					awinic,name = "blue";
					awinic,off-time-ms = <0x04>;
					awinic,rise-time-ms = <0x06>;
				};

				awinic,green {
					awinic,fall-time-ms = <0x06>;
					awinic,hold-time-ms = <0x00>;
					awinic,id = <0x01>;
					awinic,imax = <0x02>;
					awinic,led-current = <0x03>;
					awinic,max-brightness = <0xff>;
					awinic,name = "green";
					awinic,off-time-ms = <0x04>;
					awinic,rise-time-ms = <0x06>;
				};

				awinic,red {
					awinic,fall-time-ms = <0x06>;
					awinic,hold-time-ms = <0x00>;
					awinic,id = <0x00>;
					awinic,imax = <0x02>;
					awinic,led-current = <0x03>;
					awinic,max-brightness = <0xff>;
					awinic,name = "red";
					awinic,off-time-ms = <0x04>;
					awinic,rise-time-ms = <0x06>;
				};
			};

			fsa4480: fsa4480@42 {
				compatible = "qcom,fsa4480-i2c";
				phandle = <0x1e7>;
				reg = <0x42>;
				status = "disable";
			};

			pm8008_8: qcom,pm8008@8 {
				#address-cells = <0x01>;
				#interrupt-cells = <0x03>;
				#size-cells = <0x00>;
				compatible = "qcom,i2c-pmic";
				interrupt-controller;
				interrupt-names = "pm8008";
				interrupt-parent = <&tlmm>;
				interrupts = <0x19 0x01>;
				pinctrl-0 = <&pm8008_active&pm8008_interrupt>;
				pinctrl-names = "default";
				qcom,periph-map = <0x09 0x24 0xc0 0xc1>;
				reg = <0x88>;
				status = "disable";

				pm8008_gpios: pinctrl@c000 {
					#gpio-cells = <0x02>;
					compatible = "qcom,spmi-gpio";
					gpio-controller;
					interrupt-names = "pm8008_gpio1", "pm8008_gpio2";
					interrupts = <0xc0 0x00 0x01>, <0xc1 0x00 0x01>;
					reg = <0xc000 0x200>;
					status = "disable";

					pm8008_gpio1_active: pm8008_gpio1_active {
						bias-disable;
						function = "func1";
						input-disable;
						output-enable;
						phandle = <0x167>;
						pins = "gpio1";
						power-source = <0x01>;
					};
				};

				pm8008_chip: qcom,pm8008-chip@900 {
					compatible = "qcom,pm8008-chip";
					interrupt-names = "ocp";
					interrupts = <0x09 0x04 0x01>;
					reg = <0x900>;

					PM8008_EN: qcom,pm8008-chip-en {
						phandle = <0x168>;
						regulator-name = "pm8008-chip-en";
					};
				};

				qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100>;
				};
			};

			pm8008_9: qcom,pm8008@9 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "qcom,i2c-pmic";
				pinctrl-0 = <&pm8008_gpio1_active>;
				pinctrl-names = "default";
				reg = <0x09>;
				status = "disable";

				pm8008_regulators: qcom,pm8008-regulator {
					compatible = "qcom,pm8008-regulator";
					pm8008_en-supply = <&PM8008_EN>;
					status = "disable";
					vdd_l1_l2-supply = <&S6A>;
					vdd_l7-supply = <&S7A>;

					L1P: qcom,pm8008-l1@4000 {
						phandle = <0x20c>;
						qcom,hpm-min-load = <0x00>;
						qcom,min-dropout-voltage = <0xdac0>;
						reg = <0x4000>;
						regulator-max-microvolt = <0x13d620>;
						regulator-min-microvolt = <0x10c8e0>;
						regulator-name = "pm8008_l1";
					};

					L2P: qcom,pm8008-l2@4100 {
						phandle = <0x206>;
						qcom,hpm-min-load = <0x00>;
						qcom,min-dropout-voltage = <0x157c0>;
						reg = <0x4100>;
						regulator-max-microvolt = <0x118c30>;
						regulator-min-microvolt = <0xe7ef0>;
						regulator-name = "pm8008_l2";
					};

					L3P: qcom,pm8008-l3@4200 {
						phandle = <0x20b>;
						qcom,hpm-min-load = <0x00>;
						qcom,min-dropout-voltage = <0x17700>;
						reg = <0x4200>;
						regulator-max-microvolt = <0x2c4020>;
						regulator-min-microvolt = <0x2932e0>;
						regulator-name = "pm8008_l3";
					};

					L4P: qcom,pm8008-l4@4300 {
						phandle = <0x205>;
						qcom,hpm-min-load = <0x00>;
						qcom,min-dropout-voltage = <0x21340>;
						reg = <0x4300>;
						regulator-max-microvolt = <0x2c4020>;
						regulator-min-microvolt = <0x2932e0>;
						regulator-name = "pm8008_l4";
					};

					L5P: qcom,pm8008-l5@4400 {
						phandle = <0x203>;
						qcom,hpm-min-load = <0x00>;
						qcom,min-dropout-voltage = <0x3a980>;
						reg = <0x4400>;
						regulator-max-microvolt = <0x2c4020>;
						regulator-min-microvolt = <0x2932e0>;
						regulator-name = "pm8008_l5";
					};

					L6P: qcom,pm8008-l6@4400 {
						phandle = <0x219>;
						qcom,hpm-min-load = <0x00>;
						qcom,min-dropout-voltage = <0x29040>;
						reg = <0x4500>;
						regulator-max-microvolt = <0x2c4020>;
						regulator-min-microvolt = <0x2932e0>;
						regulator-name = "pm8008_l6";
					};

					L7P: qcom,pm8008-l7@4400 {
						phandle = <0x204>;
						qcom,hpm-min-load = <0x00>;
						qcom,min-dropout-voltage = <0x1b580>;
						reg = <0x4600>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-min-microvolt = <0x192d50>;
						regulator-name = "pm8008_l7";
					};
				};
			};

			wl2866d@28 {
				compatible = "ovti,wl2866d-i2c";
				en-gpio = <&tlmm 0x1a 0x00>;
				id_reg = <0x03>;
				id_val = <0x64>;
				id_val1 = <0x55>;
				init_num = <0x02>;
				inits = <0x04 0x4b 0x0e 0x0f>;
				iov-gpio = <&tlmm 0x36 0x00>;
				reg = <0x28>;
				status = "ok";
			};

			wsa881x_i2c_44: wsa881x-i2c-codec@44 {
				compatible = "qcom,wsa881x-i2c-codec";
				reg = <0x44>;
				status = "disable";
			};

			wsa881x_i2c_e: wsa881x-i2c-codec@e {
				clock-names = "wsa_mclk";
				clocks = <&wsa881x_analog_clk 0x00>;
				compatible = "qcom,wsa881x-i2c-codec";
				qcom,wsa-analog-clk-gpio = <&wsa881x_analog_clk_gpio>;
				qcom,wsa-analog-reset-gpio = <&wsa881x_analog_reset_gpio>;
				reg = <0x0e>;
				status = "disable";
			};
		};

		qupv3_se2_i2c: i2c@4a88000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-names = "se-clk", "m-ahb", "s-ahb";
			clocks = <&gcc 0x6d>, <&gcc 0x75>, <&gcc 0x76>;
			compatible = "qcom,i2c-geni";
			dma-names = "tx", "rx";
			dmas = <&gpi_dma0 0x00 0x02 0x03 0x40 0x00>, <&gpi_dma0 0x01 0x02 0x03 0x40 0x00>;
			interrupts = <0x00 0x149 0x04>;
			pinctrl-0 = <&qupv3_se2_i2c_active>;
			pinctrl-1 = <&qupv3_se2_i2c_sleep>;
			pinctrl-names = "default", "sleep";
			qcom,i2c-touch-active = "synaptics,tcm-i2c";
			qcom,wrapper-core = <&qupv3_0>;
			reg = <0x4a88000 0x4000>;
			status = "okay";

			novatek@62 {
				status = "disabled";
			};

			synaptics_tcm@20 {
				compatible = "synaptics,tcm-i2c";
				interrupt-parent = <&tlmm>;
				interrupts = <0x50 0x2008>;
				pinctrl-0 = <&ts_int_active&ts_reset_active>;
				pinctrl-1 = <&ts_int_suspend&ts_reset_suspend>;
				pinctrl-2 = <&ts_release>;
				pinctrl-names = "pmx_ts_active", "pmx_ts_suspend", "pmx_ts_release";
				reg = <0x20>;
				status = "disabled";
				synaptics,extend_report;
				synaptics,firmware-name = "synaptics_firmware_k.img";
				synaptics,irq-gpio = <&tlmm 0x50 0x2008>;
				synaptics,irq-on-state = <0x00>;
				synaptics,power-delay-ms = <0xc8>;
				synaptics,reset-active-ms = <0x14>;
				synaptics,reset-delay-ms = <0xc8>;
				synaptics,reset-gpio = <&tlmm 0x56 0x00>;
				synaptics,reset-on-state = <0x00>;
				synaptics,ubl-i2c-addr = <0x20>;
			};

			touchscreen {
				compatible = "focaltech,fts";
				focaltech,avdd-gpio = <&tlmm 0x62 0x00>;
				focaltech,display-coords = <0x00 0x00 0x438 0x960>;
				focaltech,irq-gpio = <&tlmm 0x50 0x02>;
				focaltech,max-touch-number = <0x0a>;
				focaltech,reset-gpio = <&tlmm 0x56 0x01>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x59 0x02>;
				panel1 = <&panel_k7_38_0c_0a>;
				panel2 = <&panel_k7_38_0c_0b>;
				pinctrl-0 = <&ts_int_active&ts_reset_active&ts_avdd>;
				pinctrl-1 = <&ts_int_suspend&ts_reset_suspend>;
				pinctrl-2 = <&ts_release>;
				pinctrl-names = "pmx_ts_active", "pmx_ts_suspend", "pmx_ts_release";
				reg = <0x38>;
				status = "ok";
				vcc_i2c-supply = <&L9A>;
			};
		};

		qupv3_se4_i2c: i2c@4a90000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-names = "se-clk", "m-ahb", "s-ahb";
			clocks = <&gcc 0x71>, <&gcc 0x75>, <&gcc 0x76>;
			compatible = "qcom,i2c-geni";
			dma-names = "tx", "rx";
			dmas = <&gpi_dma0 0x00 0x04 0x03 0x40 0x00>, <&gpi_dma0 0x01 0x04 0x03 0x40 0x00>;
			interrupts = <0x00 0x14b 0x04>;
			pinctrl-0 = <&qupv3_se4_i2c_active>;
			pinctrl-1 = <&qupv3_se4_i2c_sleep>;
			pinctrl-names = "default", "sleep";
			qcom,wrapper-core = <&qupv3_0>;
			reg = <0x4a90000 0x4000>;
			status = "OK";
