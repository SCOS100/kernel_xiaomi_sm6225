			regulator-names = "camss-vdd";
			src-clock-name = "gcc_camss_axi_clk_src";
			status = "ok";
			vdd-corner-ahb-mapping = "suspend", "minsvs", "lowsvs", "svs", "svs_l1", "nominal", "nominal", "nominal", "turbo", "turbo";
			vdd-corners = <0x10 0x30 0x40 0x80 0xc0 0x100 0x140 0x150 0x180 0x1a0>;

			camera-bus-nodes {

				level0-nodes {
					level-index = <0x00>;

					cpas_cdm0_all_rd: cpas-cdm0-all-rd {
						cell-index = <0x09>;
						client-name = "cpas-cdm0";
						node-name = "cpas-cdm0-all-rd";
						parent-node = <&level1_nrt0_rd_wr>;
						traffic-data = <0x100>;
						traffic-transaction-type = <0x00>;
					};

					ope_cdm0_all_rd: ope-cdm0-all-rd {
						cell-index = <0x0a>;
						client-name = "ope-cdm0";
						node-name = "ope-cdm0-all-rd";
						parent-node = <&level1_nrt0_rd_wr>;
						traffic-data = <0x100>;
						traffic-transaction-type = <0x00>;
					};

					ope0_all_rd: ope0-all-rd {
						cell-index = <0x05>;
						client-name = "ope0";
						constituent-paths = <0x40 0x41>;
						node-name = "ope0-all-rd";
						parent-node = <&level1_nrt0_rd_wr>;
						traffic-data = <0x100>;
						traffic-transaction-type = <0x00>;
					};

					ope0_all_wr: ope0-all-wr {
						cell-index = <0x04>;
						client-name = "ope0";
						constituent-paths = <0x42 0x43 0x44>;
						node-name = "ope0-all-wr";
						parent-node = <&level1_nrt0_rd_wr>;
						traffic-data = <0x100>;
						traffic-transaction-type = <0x01>;
