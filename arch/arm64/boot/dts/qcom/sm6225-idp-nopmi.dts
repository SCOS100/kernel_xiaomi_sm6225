			clock-cntl-level = "suspend", "minsvs", "lowsvs", "svs", "nominal", "turbo";
			clock-names = "gcc_camss_ahb_clk", "gcc_camss_top_ahb_clk", "gcc_camss_top_ahb_clk_src", "gcc_camss_axi_clk", "gcc_camss_axi_clk_src", "gcc_camss_nrt_axi_clk", "gcc_camss_rt_axi_clk";
			clock-rates = <0x00 0x00 0x00 0x00 0x00 0x00 0x00>, <0x00 0x00 0x4c4b400 0x00 0x124f800 0x00 0x00>, <0x00 0x00 0x4c4b400 0x00 0x8f0d180 0x00 0x00>, <0x00 0x00 0x4c4b400 0x00 0xe4e1c00 0x00 0x00>, <0x00 0x00 0x4c4b400 0x00 0x11e1a300 0x00 0x00>, <0x00 0x00 0x4c4b400 0x00 0x11e1a300 0x00 0x00>;
			clocks = <&gcc 0x16>, <&gcc 0x45>, <&gcc 0x46>, <&gcc 0x18>, <&gcc 0x19>, <&gcc 0x2f>, <&gcc 0x34>;
			compatible = "qcom,cam-cpas";
