					compatible = "qcom,rpm-smd-regulator";
					phandle = <0x16a>;
					qcom,init-voltage = <0x1f20c0>;
					qcom,set = <0x03>;
					regulator-max-microvolt = <0x1f20c0>;
					regulator-min-microvolt = <0x17f0e8>;
					regulator-name = "pm6125_s7";
					status = "okay";
				};
			};

			rpm-regulator-smpa8 {
				compatible = "qcom,rpm-smd-regulator-resource";
				qcom,hpm-min-load = <0x186a0>;
				qcom,regulator-type = <0x01>;
				qcom,resource-id = <0x08>;
				qcom,resource-name = "smpa";
				status = "okay";

				pm6125_s8: S8A: regulator-s8 {
					compatible = "qcom,rpm-smd-regulator";
					qcom,init-voltage = <0x113640>;
					qcom,set = <0x03>;
					regulator-max-microvolt = <0x11da50>;
					regulator-min-microvolt = <0x102ca0>;
					regulator-name = "pm6125_s8";
					status = "okay";
				};
			};

			rpm_smd_cdev: rpm-smd-cdev {
				#cooling-cells = <0x02>;
				compatible = "qcom,rpm-smd-cooling-device";
				phandle = <0xbe>;
			};
		};

		qcom,rpm-stats@4600000 {
			compatible = "qcom,rpm-stats";
			qcom,sleep-stats-version = <0x02>;
			reg = <0x4600000 0x1000>, <0x4690014 0x04>;
			reg-names = "phys_addr_base", "offset_addr";
		};

		smem: qcom,smem {
			compatible = "qcom,smem";
			hwlocks = <&tcsr_mutex 0x03>;
			memory-region = <&smem_mem>;
		};

		qcom,smp2p-adsp {
			compatible = "qcom,smp2p";
			interrupts = <0x00 0x117 0x01>;
			mboxes = <&apcs_glb 0x0a>;
			qcom,local-pid = <0x00>;
			qcom,remote-pid = <0x02>;
			qcom,smem = <0x1bb>, <0x1ad>;

			adsp_smp2p_out: master-kernel {
				#qcom,smem-state-cells = <0x01>;
				phandle = <0x7a>;
				qcom,entry-name = "master-kernel";
			};

			sleepstate_smp2p_in: qcom,sleepstate-in {
				#interrupt-cells = <0x02>;
				interrupt-controller;
				phandle = <0xe0>;
				qcom,entry-name = "sleepstate_see";
			};

			smp2p_rdbg2_in: qcom,smp2p-rdbg2-in {
				#interrupt-cells = <0x02>;
				interrupt-controller;
				phandle = <0x22e>;
				qcom,entry-name = "rdbg";
			};

			smp2p_rdbg2_out: qcom,smp2p-rdbg2-out {
				#qcom,smem-state-cells = <0x01>;
				phandle = <0x22d>;
				qcom,entry-name = "rdbg";
			};

			adsp_smp2p_in: slave-kernel {
				#interrupt-cells = <0x02>;
				interrupt-controller;
				phandle = <0x79>;
				qcom,entry-name = "slave-kernel";
			};

			sleepstate_smp2p_out: sleepstate-out {
				#qcom,smem-state-cells = <0x01>;
				phandle = <0xdf>;
				qcom,entry-name = "sleepstate";
			};
		};

		qcom,smp2p-cdsp {
			compatible = "qcom,smp2p";
			interrupts = <0x00 0x107 0x01>;
			mboxes = <&apcs_glb 0x1e>;
			qcom,local-pid = <0x00>;
			qcom,remote-pid = <0x05>;
			qcom,smem = <0x5e>, <0x1b0>;

			cdsp_smp2p_out: master-kernel {
				#qcom,smem-state-cells = <0x01>;
				phandle = <0x7e>;
				qcom,entry-name = "master-kernel";
			};

			smp2p_rdbg5_in: qcom,smp2p-rdbg5-in {
				#interrupt-cells = <0x02>;
				interrupt-controller;
				phandle = <0x230>;
				qcom,entry-name = "rdbg";
			};

			smp2p_rdbg5_out: qcom,smp2p-rdbg5-out {
				#qcom,smem-state-cells = <0x01>;
				phandle = <0x22f>;
				qcom,entry-name = "rdbg";
			};

			cdsp_smp2p_in: slave-kernel {
				#interrupt-cells = <0x02>;
				interrupt-controller;
				phandle = <0x7d>;
				qcom,entry-name = "slave-kernel";
			};
		};

		qcom,smp2p-modem {
			compatible = "qcom,smp2p";
			interrupts = <0x00 0x46 0x01>;
			mboxes = <&apcs_glb 0x0e>;
			qcom,local-pid = <0x00>;
			qcom,remote-pid = <0x01>;
			qcom,smem = <0x1b3>, <0x1ac>;

			modem_smp2p_out: master-kernel {
				#qcom,smem-state-cells = <0x01>;
				phandle = <0xed>;
				qcom,entry-name = "master-kernel";
			};

			smp2p_ipa_1_in: qcom,smp2p-ipa-1-in {
				#interrupt-cells = <0x02>;
				interrupt-controller;
				phandle = <0xf5>;
				qcom,entry-name = "ipa";
			};

			smp2p_ipa_1_out: qcom,smp2p-ipa-1-out {
				#qcom,smem-state-cells = <0x01>;
				phandle = <0xf4>;
				qcom,entry-name = "ipa";
			};

			smp2p_wlan_1_in: qcom,smp2p-wlan-1-in {
				#interrupt-cells = <0x02>;
				interrupt-controller;
				phandle = <0xe8>;
				qcom,entry-name = "wlan";
			};

			modem_smp2p_in: slave-kernel {
				#interrupt-cells = <0x02>;
				interrupt-controller;
				phandle = <0xec>;
				qcom,entry-name = "slave-kernel";
			};
		};

		qcom,smp2p_interrupt_rdbg_2_in {
			compatible = "qcom,smp2p-interrupt-rdbg-2-in";
			interrupt-names = "rdbg-smp2p-in";
			interrupts-extended = <&smp2p_rdbg2_in 0x00 0x00>;
		};

		qcom,smp2p_interrupt_rdbg_2_out {
			compatible = "qcom,smp2p-interrupt-rdbg-2-out";
			qcom,smem-state-names = "rdbg-smp2p-out";
			qcom,smem-states = <&smp2p_rdbg2_out 0x00>;
		};

		qcom,smp2p_interrupt_rdbg_5_in {
			compatible = "qcom,smp2p-interrupt-rdbg-5-in";
			interrupt-names = "rdbg-smp2p-in";
			interrupts-extended = <&smp2p_rdbg5_in 0x00 0x00>;
		};

		qcom,smp2p_interrupt_rdbg_5_out {
			compatible = "qcom,smp2p-interrupt-rdbg-5-out";
			qcom,smem-state-names = "rdbg-smp2p-out";
			qcom,smem-states = <&smp2p_rdbg5_out 0x00>;
		};

		qcom,smp2p_sleepstate {
			compatible = "qcom,smp2p-sleepstate";
			interrupt-names = "smp2p-sleepstate-in";
			interrupt-parent = <&sleepstate_smp2p_in>;
			interrupts = <0x00 0x00>;
			qcom,smem-states = <&sleepstate_smp2p_out 0x00>;
		};

		spmi_bus: qcom,spmi@1c40000 {
			#address-cells = <0x01>;
			#interrupt-cells = <0x04>;
			#size-cells = <0x01>;
			cell-index = <0x00>;
			compatible = "qcom,spmi-pmic-arb";
			interrupt-controller;
			interrupt-names = "periph_irq";
			interrupts = <0x00 0xb7 0x04>;
			qcom,channel = <0x00>;
			qcom,ee = <0x00>;
			reg = <0x1c40000 0x1100>, <0x1e00000 0x2000000>, <0x3e00000 0x100000>, <0x3f00000 0xa0000>, <0x1c0a000 0x26000>;
			reg-names = "core", "chnls", "obsrvr", "intr", "cnfg";

			qcom,pm6125@0 {
				#address-cells = <0x02>;
				#size-cells = <0x00>;
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;

				pm6125_adc_tm_iio: adc_tm@3400 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					compatible = "qcom,adc-tm5-iio";
					io-channels = <&pm6125_vadc 0x52>, <&pm6125_vadc 0x53>;
					phandle = <0xa7>;
					reg = <0x3400 0x100>;

					camera_flash_therm {
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
						reg = <0x52>;
					};

					emmc_ufs_therm {
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
						reg = <0x53>;
					};
				};

				pm6125_adc_tm: adc_tm@3500 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					compatible = "qcom,adc-tm5";
					interrupt-names = "thr-int-en";
					interrupts = <0x00 0x35 0x00 0x01>;
					io-channels = <&pm6125_vadc 0x4d>, <&pm6125_vadc 0x4e>, <&pm6125_vadc 0x4c>, <&pm6125_vadc 0x55>;
					phandle = <0xa6>;
					reg = <0x3500 0x100>;

					pa_therm0 {
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
						reg = <0x4d>;
					};

					quiet_therm {
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
						reg = <0x4e>;
					};

					rf_pa1_therm {
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
						reg = <0x55>;
					};

					xo_therm {
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
						reg = <0x4c>;
					};
				};

				pm6125_clkdiv: clock-controller@5b00 {
					#clock-cells = <0x01>;
					assigned-clock-rates = <0x927c00>;
					assigned-clocks = <&pm6125_clkdiv 0x01>;
					clock-names = "xo";
					clock-output-names = "pm6125_div_clk1";
					clocks = <&rpmcc 0x00>;
					compatible = "qcom,spmi-clkdiv";
					phandle = <0xe5>;
					qcom,num-clkdivs = <0x01>;
					reg = <0x5b00 0x100>;
				};

				pm6125_gpios: pinctrl@c000 {
					#gpio-cells = <0x02>;
					compatible = "qcom,spmi-gpio";
					gpio-controller;
					interrupt-names = "pm6125_gpio1", "pm6125_gpio2", "pm6125_gpio3", "pm6125_gpio4", "pm6125_gpio5", "pm6125_gpio6", "pm6125_gpio7", "pm6125_gpio8", "pm6125_gpio9";
					interrupts = <0x00 0xc0 0x00 0x00>, <0x00 0xc1 0x00 0x00>, <0x00 0xc2 0x00 0x00>, <0x00 0xc3 0x00 0x00>, <0x00 0xc4 0x00 0x00>, <0x00 0xc5 0x00 0x00>, <0x00 0xc6 0x00 0x00>, <0x00 0xc7 0x00 0x00>, <0x00 0xc8 0x00 0x00>;
					phandle = <0x1f6>;
					reg = <0xc000 0x900>;

					camera_therm {

						camera_therm_default: camera_therm_default {
							bias-high-impedance;
							phandle = <0xe1>;
							pins = "gpio3";
						};
					};

					disp_lcd_bias_en {

						disp_lcd_bias_en_default: disp_lcd_bias_en_default {
							bias-disable;
							function = "func1";
							input-disable;
							output-enable;
							pins = "gpio9";
							power-source = <0x00>;
							qcom,drive-strength = <0x02>;
						};
					};

					eldo9_pin {

						usb_eldo9: gpio@c000 {
							bias-disable;
							function = "normal";
							output-high;
							phandle = <0x239>;
							pins = "gpio1";
							power-source = <0x00>;
							qcom,drive-strength = <0x02>;
						};
					};

					emmc_therm {

						emmc_therm_default: emmc_therm_default {
							bias-high-impedance;
							phandle = <0xe2>;
							pins = "gpio4";
						};
					};

					gpio9_panel_en: gpio9-panel-en {
						bias-disable;
						function = "normal";
						output-low;
						pins = "gpio9";
						power-source = <0x01>;
					};

					key_vol_up {

						key_vol_up_default: key_vol_up_default {
							bias-pull-up;
							function = "normal";
							input-enable;
							phandle = <0x235>;
							pins = "gpio5";
							power-source = <0x00>;
						};
					};

					oled_vci {

						oled_vci_default: oled_vci_default {
							bias-disable;
							function = "normal";
							input-disable;
							output-high;
							pins = "gpio9";
							power-source = <0x00>;
							qcom,drive-strength = <0x02>;
						};

						oled_vci_suspend: oled_vci_suspend {
							bias-disable;
							function = "normal";
							input-disable;
							output-low;
							pins = "gpio9";
							power-source = <0x00>;
							qcom,drive-strength = <0x02>;
						};
					};

					pwm_out_gpio8 {

						pwm_out_gpio8_default: pwm_out_gpio8_default {
							bias-disable;
							drive-push-pull;
							function = "func1";
							output-low;
							phandle = <0x238>;
							pins = "gpio8";
							power-source = <0x00>;
							qcom,drive-strength = <0x03>;
						};
					};

					rf_pa1_therm {

						rf_pa1_therm_default: rf_pa1_therm_default {
							bias-high-impedance;
							phandle = <0xe3>;
							pins = "gpio7";
						};
					};
				};

				pm6125_rtc: qcom,pm6125_rtc {
					compatible = "qcom,pm8941-rtc";
					interrupts = <0x00 0x61 0x01 0x00>;
				};

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					interrupt-names = "kpdpwr", "resin";
					interrupts = <0x00 0x08 0x00 0x03>, <0x00 0x08 0x01 0x03>;
					qcom,kpdpwr-sw-debounce;
					qcom,pon-dbc-delay = <0x3d09>;
					qcom,store-hard-reset-reason;
					qcom,system-reset;
					reg = <0x800 0x100>;

					qcom,pon_1 {
						linux,code = <0x74>;
						qcom,pon-type = <0x00>;
						qcom,pull-up = <0x01>;
						qcom,s1-timer = <0x1180>;
						qcom,s2-timer = <0x7d0>;
						qcom,s2-type = <0x07>;
						qcom,support-reset = <0x01>;
					};

					qcom,pon_2 {
						linux,code = <0x72>;
						qcom,pon-type = <0x01>;
						qcom,pull-up = <0x01>;
					};

					qcom,pon_3 {
						qcom,pon-type = <0x03>;
						qcom,pull-up = <0x01>;
						qcom,s1-timer = <0x1180>;
						qcom,s2-timer = <0x3e8>;
						qcom,s2-type = <0x01>;
						qcom,support-reset = <0x01>;
					};
				};

				pm6125_revid: qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100 0x100>;
				};

				pm6125_tz: qcom,temp-alarm@2400 {
					#thermal-sensor-cells = <0x00>;
					compatible = "qcom,spmi-temp-alarm";
					interrupts = <0x00 0x24 0x00 0x03>;
					phandle = <0x9b>;
					qcom,temperature-threshold-set = <0x01>;
					reg = <0x2400 0x100>;
				};

				pm6125_vadc: vadc@3100 {
					#address-cells = <0x01>;
					#io-channel-cells = <0x01>;
					#size-cells = <0x00>;
					compatible = "qcom,spmi-adc5";
					interrupt-names = "eoc-int-en-set";
					interrupts = <0x00 0x31 0x00 0x01>;
					io-channel-ranges;
					phandle = <0xe4>;
					pinctrl-0 = <&camera_therm_default&emmc_therm_default&rf_pa1_therm_default>;
					pinctrl-names = "default";
					qcom,adc-vdd-reference = <0x753>;
					reg = <0x3100 0x100>;

					camera_flash_therm {
						label = "camera_flash_therm";
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,ratiometric;
						reg = <0x52>;
					};

					die_temp {
						label = "die_temp";
						qcom,pre-scaling = <0x01 0x01>;
						reg = <0x06>;
					};

					emmc_ufs_therm {
						label = "emmc_ufs_therm";
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,ratiometric;
						reg = <0x53>;
					};

					pa_therm0 {
						label = "pa_therm0";
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,ratiometric;
						reg = <0x4d>;
					};

					quiet_therm {
						label = "quiet_therm";
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,ratiometric;
						reg = <0x4e>;
					};

					ref_gnd {
						label = "ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
						reg = <0x00>;
					};

					rf_pa1_therm {
						label = "rf_pa1_therm";
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,ratiometric;
						reg = <0x55>;
					};

					vcoin {
						label = "vcoin";
						qcom,pre-scaling = <0x01 0x03>;
						reg = <0x85>;
					};

					vph_pwr {
						label = "vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
						reg = <0x83>;
					};

					vref_1p25 {
						label = "vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
						reg = <0x01>;
					};

					xo_therm {
						label = "xo_therm";
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,ratiometric;
						reg = <0x4c>;
					};
				};
			};

			qcom,pm6125@1 {
				#address-cells = <0x02>;
				#size-cells = <0x00>;
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;

				pm6125_pwm: qcom,pwms@b300 {
					#pwm-cells = <0x02>;
					compatible = "qcom,pwm-lpg";
					phandle = <0x1fb>;
					qcom,num-lpg-channels = <0x01>;
					reg = <0xb300 0x100>;
					reg-names = "lpg-base";
					status = "ok";
				};
			};
		};

		qcom,sps {
			compatible = "qcom,msm-sps-4k";
			qcom,pipe-attr-ee;
		};

		cam_tfe0: qcom,tfe0@5c6e000 {
			camss-supply = <&gcc_camss_top_gdsc>;
			cell-index = <0x00>;
			clock-cntl-level = "svs", "svs_l1", "turbo";
			clock-control-debugfs = "true";
			clock-names = "tfe_clk_src", "tfe_clk";
			clock-rates = <0x11e1a300 0x00>, <0x1b774000 0x00>, <0x22551000 0x00>;
			clocks = <&gcc 0x36>, <&gcc 0x35>;
			compatible = "qcom,tfe530";
			interrupt-names = "tfe0";
			interrupts = <0x00 0xd3 0x01>;
			reg = <0x5c6e000 0x5000>;
			reg-cam-base = <0x6e000>;
			reg-names = "tfe0";
			regulator-names = "camss";
			src-clock-name = "tfe_clk_src";
			status = "ok";
		};

		cam_tfe1: qcom,tfe1@5c75000 {
			camss-supply = <&gcc_camss_top_gdsc>;
			cell-index = <0x01>;
			clock-cntl-level = "svs", "svs_l1", "turbo";
			clock-control-debugfs = "true";
			clock-names = "tfe_clk_src", "tfe_clk";
			clock-rates = <0x11e1a300 0x00>, <0x1b774000 0x00>, <0x22551000 0x00>;
			clocks = <&gcc 0x3b>, <&gcc 0x3a>;
			compatible = "qcom,tfe530";
			interrupt-names = "tfe1";
			interrupts = <0x00 0xd5 0x01>;
			reg = <0x5c75000 0x5000>;
			reg-cam-base = <0x75000>;
			reg-names = "tfe1";
			regulator-names = "camss";
			src-clock-name = "tfe_clk_src";
			status = "ok";
		};

		cam_tfe2: qcom,tfe2@5c7c000 {
			camss-supply = <&gcc_camss_top_gdsc>;
			cell-index = <0x02>;
			clock-cntl-level = "svs", "svs_l1", "turbo";
			clock-control-debugfs = "true";
			clock-names = "tfe_clk_src", "tfe_clk";
			clock-rates = <0x11e1a300 0x00>, <0x1b774000 0x00>, <0x22551000 0x00>;
			clocks = <&gcc 0x40>, <&gcc 0x3f>;
			compatible = "qcom,tfe530";
			interrupt-names = "tfe2";
