			qcom,ion-heap@10 {
				memory-region = <&secure_display_memory>;
				qcom,ion-heap-type = "HYP_CMA";
				reg = <0x0a>;
			};

			qcom,ion-heap@14 {
				qcom,ion-heap-type = "SECURE_CARVEOUT";
				reg = <0x0e>;

