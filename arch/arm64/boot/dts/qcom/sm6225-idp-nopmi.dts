			qcom,proxy-clock-names = "core_clk", "iface_clk", "bus_clk", "core0_clk", "core0_bus_clk", "throttle_clk";
			reg = <0x5a00000 0x200000>;
			status = "ok";
			venus-core0-supply = <&gcc_vcodec0_gdsc>;
			venus-supply = <&gcc_venus_gdsc>;

			arm9_bus_ddr {
				compatible = "qcom,msm-vidc,bus";
