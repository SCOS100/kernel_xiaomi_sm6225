		replicator_qdss: replicator@8046000 {
			arm,primecell-periphid = <0xbb909>;
			clock-names = "apb_pclk";
			clocks = <&rpmcc 0x08>;
			compatible = "arm,primecell";
			coresight-name = "coresight-replicator-qdss";
			reg = <0x8046000 0x1000>;
			reg-names = "replicator-base";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					replicator_qdss_out_tmc_etr: endpoint {
						phandle = <0x6a>;
						remote-endpoint = <&tmc_etr_in_replicator_qdss>;
					};
				};

				port@1 {
					reg = <0x00>;

					replicator_qdss_in_tmc_etf: endpoint {
						phandle = <0x65>;
						remote-endpoint = <&tmc_etf_out_replicator_qdss>;
						slave-mode;
