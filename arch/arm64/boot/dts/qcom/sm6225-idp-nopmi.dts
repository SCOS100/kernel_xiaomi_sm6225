			#size-cells = <0x01>;
			clock-names = "gcc_gpu_memnoc_gfx", "gcc_gpu_snoc_dvm_gfx", "gpu_cc_ahb", "gpu_cc_hlos1_vote_gpu_smmu_clk";
			clocks = <&gcc 0x5a>, <&gcc 0x5b>, <&gpucc 0x03>, <&gpucc 0x0e>;
