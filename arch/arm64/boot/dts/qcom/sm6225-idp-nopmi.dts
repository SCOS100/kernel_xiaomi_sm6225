			qcom,msm-bus,num-cases = <0x07>;
			qcom,msm-bus,num-paths = <0x01>;
			qcom,msm-bus,vectors-KBps = <0x01 0x24d 0x00 0x00>, <0x01 0x24d 0x00 0x208d5>, <0x01 0x24d 0x00 0x208d5>, <0x01 0x24d 0x00 0x249f0>, <0x01 0x24d 0x00 0x249f0>, <0x01 0x24d 0x00 0x493e0>, <0x01 0x24d 0x00 0x493e0>;
			reg = <0x5c11000 0x1000>, <0x5c13000 0x5800>;
