						client-name = "tfe0";
						constituent-paths = <0x04 0x05 0x06 0x07 0x01 0x02 0x03>;
						node-name = "tfe0-all-wr";
						parent-node = <&level1_rt0_wr>;
						traffic-data = <0x100>;
						traffic-transaction-type = <0x01>;
					};

					tfe1_all_wr: tfe1-all-wr {
						cell-index = <0x07>;
						client-name = "tfe1";
						constituent-paths = <0x04 0x05 0x06 0x07 0x01 0x02 0x03>;
						node-name = "tfe1-all-wr";
						parent-node = <&level1_rt0_wr>;
						traffic-data = <0x100>;
						traffic-transaction-type = <0x01>;
					};

					tfe2_all_wr: tfe2-all-wr {
						cell-index = <0x08>;
						client-name = "tfe2";
						constituent-paths = <0x04 0x05 0x06 0x07 0x01 0x02 0x03>;
						node-name = "tfe2-all-wr";
						parent-node = <&level1_rt0_wr>;
						traffic-data = <0x100>;
						traffic-transaction-type = <0x01>;
					};
				};

				level1-nodes {
					camnoc-max-needed;
					level-index = <0x01>;

					level1_nrt0_rd_wr: level1-nrt0-rd-wr {
						cell-index = <0x03>;
						node-name = "level1-nrt0-rd-wr";
						parent-node = <&level2_nrt0_rd_wr_sum>;
						phandle = <0x22b>;
						traffic-merge-type = <0x01>;
					};

					level1_rt0_wr: level1-rt0-wr {
						cell-index = <0x02>;
						node-name = "level1-rt0-wr";
						parent-node = <&level2_rt0_rd_wr_sum>;
						phandle = <0x22c>;
						traffic-merge-type = <0x01>;
					};
				};

				level2-nodes {
					level-index = <0x02>;

					level2_nrt0_rd_wr_sum: level2-nrt0-rd-wr-sum {
						cell-index = <0x01>;
						node-name = "level2-nrt0-rd-wr-sum";
						phandle = <0x22a>;
						qcom,axi-port-name = "cam_sf_0";
						traffic-merge-type = <0x00>;

						qcom,axi-port-mnoc {
							qcom,msm-bus,name = "cam_sf_0_mnoc";
							qcom,msm-bus,num-cases = <0x02>;
