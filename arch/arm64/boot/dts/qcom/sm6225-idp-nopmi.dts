					bias-pull-down;
					drive-strength = <0x08>;
					output-high;
					pins = "ufs_reset";
				};
			};

			wcd937x_reset_active: wcd937x_reset_active {
				phandle = <0x231>;

				config {
					drive-strength = <0x10>;
					output-high;
					pins = "gpio92";
				};

				mux {
					function = "gpio";
					pins = "gpio92";
				};
			};

			wcd937x_reset_sleep: wcd937x_reset_sleep {
				phandle = <0x232>;

				config {
					bias-disable;
					drive-strength = <0x10>;
					output-low;
					pins = "gpio92";
				};

				mux {
					function = "gpio";
					pins = "gpio92";
				};
			};
		};

