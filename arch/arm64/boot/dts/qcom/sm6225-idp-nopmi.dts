		msm_vidc: qcom,vidc@5a00000 {
			clock-names = "core_clk", "iface_clk", "bus_clk", "core0_clk", "core0_bus_clk", "throttle_clk";
			clocks = <&gcc 0xa1>, <&gcc 0x9c>, <&gcc 0x9b>, <&gcc 0x9f>, <&gcc 0x99>, <&gcc 0x9e>;
