		apps_iommu_coherent_test_device {
			compatible = "iommu-debug-test";
			dma-coherent;
			iommus = <&apps_smmu 0x1e1 0x00>;
			qcom,iommu-dma = "disabled";
		};

		apps_iommu_test_device {
			compatible = "iommu-debug-test";
			iommus = <&apps_smmu 0x1e0 0x00>;
			qcom,iommu-dma = "disabled";
		};

		arm64_cpu_erp {
			compatible = "arm,arm64-cpu-erp";
			interrupt-names = "pri-dbe-irq", "sec-dbe-irq", "pri-ext-irq", "sec-ext-irq";
			interrupts = <0x00 0x2b 0x04>, <0x00 0x2c 0x04>, <0x00 0x29 0x04>, <0x00 0x2a 0x04>;
			poll-delay-ms = <0x1388>;
		};

		audio_etm0: audio_etm0 {
			compatible = "qcom,coresight-remote-etm";
			coresight-name = "coresight-audio-etm0";
			qcom,inst-id = <0x05>;

			port {

				audio_etm0_out_funnel_qatb: endpoint {
					phandle = <0x56>;
					remote-endpoint = <&funnel_qatb_in_audio_etm0>;
				};
			};
		};

		aw87xxx_pa_reset_gpio {
			audio-reset-pin = <&wsa881x_analog_reset_gpio>;
			compatible = "longcheer,lct_pinctrl";
			status = "okay";
		};

		backlight: backlight {
			brightness-levels = <0x00 0x64 0xc8 0x12c 0x190 0x1f4 0x258 0x2bc 0x320 0x384 0x3e8>;
			compatible = "pwm-backlight";
			default-brightness-level = <0x1f4>;
			num-interpolated-steps = <0x64>;
			phandle = <0x1f7>;
			power-supply = <&L9A>;
			pwms = <&pm6125_pwm 0x00 0xf4240>;
		};

		bluetooth: bt_wcn3990 {
			compatible = "qca,wcn3990";
			qca,bt-sw-ctrl-gpio = <&tlmm 0x57 0x00>;
			qca,bt-vdd-core-current-level = <0x01>;
			qca,bt-vdd-core-supply = <&L17A>;
			qca,bt-vdd-core-voltage-level = <0x13e5c0 0x13e5c0>;
			qca,bt-vdd-io-current-level = <0x01>;
			qca,bt-vdd-io-supply = <&L9A>;
			qca,bt-vdd-io-voltage-level = <0x19f0a0 0x1cfde0>;
			qca,bt-vdd-pa-current-level = <0x01>;
			qca,bt-vdd-pa-supply = <&L23A>;
			qca,bt-vdd-pa-voltage-level = <0x2dc6c0 0x328980>;
			qca,bt-vdd-xtal-current-level = <0x01>;
			qca,bt-vdd-xtal-supply = <&L16A>;
			qca,bt-vdd-xtal-voltage-level = <0x19f0a0 0x1cfde0>;
		};

		rpmcc: clock-controller {
			#clock-cells = <0x01>;
			compatible = "qcom,rpmcc-bengal";
			phandle = <0x10>;
		};

		debugcc: clock-controller@0 {
			#clock-cells = <0x01>;
			clock-names = "xo_clk_src";
			clocks = <&rpmcc 0x00>;
			compatible = "qcom,khaje-debugcc";
			qcom,cpucc = <&cpucc_debug>;
			qcom,dispcc = <&dispcc>;
			qcom,gcc = <&gcc>;
			qcom,gpucc = <&gpucc>;
			qcom,mccc = <&mccc_debug>;
		};

		gcc: clock-controller@1400000 {
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			compatible = "qcom,khaje-gcc", "syscon";
			phandle = <0x72>;
			reg = <0x1400000 0x1f0000>;
			reg-names = "cc_base";
			vdd_cx-supply = <&VDD_CX_LEVEL>;
			vdd_mx-supply = <&VDD_MX_LEVEL>;
		};

		gpucc: clock-controller@5990000 {
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			compatible = "qcom,khaje-gpucc", "syscon";
			phandle = <0xd3>;
			qcom,gpu_cc_gx_gfx3d_clk_src-opp-handle = <&msm_gpu>;
			reg = <0x5990000 0x9000>;
			reg-names = "cc_base";
			vdd_cx-supply = <&VDD_CX_LEVEL>;
			vdd_mx-supply = <&VDD_MX_LEVEL>;
		};

		dispcc: clock-controller@5f00000 {
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			clock-names = "cfg_ahb_clk";
			clocks = <&gcc 0x49>;
			compatible = "qcom,khaje-dispcc", "syscon";
			phandle = <0xd2>;
			reg = <0x5f00000 0x20000>;
			reg-names = "cc_base";
			vdd_cx-supply = <&VDD_CX_LEVEL>;
		};

		clocks {

			sleep_clk: sleep_clk {
				#clock-cells = <0x00>;
				clock-frequency = <0x7ffc>;
				clock-output-names = "sleep_clk";
				compatible = "fixed-clock";
			};

			usb3_phy_wrapper_gcc_usb30_pipe_clk: usb3_phy_wrapper_gcc_usb30_pipe_clk {
				#clock-cells = <0x00>;
				clock-frequency = <0x3e8>;
				clock-output-names = "usb3_phy_wrapper_gcc_usb30_pipe_clk";
				compatible = "fixed-clock";
				phandle = <0x108>;
			};

			xo_board: xo_board {
				#clock-cells = <0x00>;
				clock-frequency = <0x124f800>;
				clock-output-names = "xo_board";
				compatible = "fixed-clock";
			};
		};

		cpu_pmu: cpu-pmu {
