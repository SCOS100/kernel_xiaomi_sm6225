/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	compatible = "qcom,khaje-idp", "qcom,khaje", "qcom,idp";
	interrupt-parent = <&wakegic>;
	model = "Qualcomm Technologies, Inc. KHAJE IDP nopmi";
	qcom,board-id = <0x10022 0x00>;
	qcom,msm-id = <0x206 0x10000>, <0x24a 0x10000>;
	qcom,pmic-id = <0x2d 0x00 0x00 0x00>;

	aliases {
		dsi_panel_k7_38_0c_0a_video = "/soc/mdss@5e00000/dsi@5e94000/panel@0";
		dsi_panel_k7_38_0c_0b_video = "/soc/mdss@5e00000/dsi@5e94000/panel@1";
		sdhc1 = "/soc/sdhci@4744000";
		sdhc2 = "/soc/sdhci@4784000";
		spi0 = "/soc/spi@4a80000";
		swr0 = "/soc/qcom,msm-audio-apr/qcom,q6core-audio/bolero-cdc/va-macro@a730000/va_swr_master";
		swr1 = "/soc/qcom,msm-audio-apr/qcom,q6core-audio/bolero-cdc/rx-macro@a600000/rx_swr_master";
		ufshc1 = "/soc/ufshc@4804000";
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		bootargs = "rcupdate.rcu_expedited=1 rcu_nocbs=0-7 kpti=off";
		ranges;

		framebuffer0: framebuffer@5c000000 {
			compatible = "simple-framebuffer";
			format = "a8b8g8r8";
			height = <0x960>;
			reg = <0x00 0x5c000000 0x00 0xf00000>;
			status = "okay";
			stride = <0x10e0>;
			width = <0x438>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <&CPU0>;
				};

				core1 {
					cpu = <&CPU1>;
				};

				core2 {
					cpu = <&CPU2>;
				};

				core3 {
					cpu = <&CPU3>;
				};
			};

			cluster1 {

				core0 {
					cpu = <&CPU4>;
				};

				core1 {
					cpu = <&CPU5>;
				};

				core2 {
					cpu = <&CPU6>;
				};

				core3 {
					cpu = <&CPU7>;
				};
			};
		};

		CPU0: cpu@0 {
			#cooling-cells = <0x02>;
			capacity-dmips-mhz = <0x400>;
			compatible = "arm,armv8";
			device_type = "cpu";
			dynamic-power-coefficient = <0x64>;
			enable-method = "psci";
			next-level-cache = <&L2_0>;
			phandle = <0x07>;
			qcom,freq-domain = <&cpufreq_hw 0x00 0x07>;
			qcom,lmh-dcvs = <&lmh_dcvs0>;
			reg = <0x00 0x00>;

			L1_D_0: l1-dcache {
				compatible = "arm,arch-cache";
			};

			L1_I_0: l1-icache {
				compatible = "arm,arch-cache";
			};

			L2_0: l2-cache {
				cache-level = <0x02>;
				compatible = "arm,arch-cache";
				phandle = <0x02>;
			};
		};

		CPU1: cpu@1 {
			capacity-dmips-mhz = <0x400>;
			compatible = "arm,armv8";
			device_type = "cpu";
			dynamic-power-coefficient = <0x64>;
			enable-method = "psci";
			next-level-cache = <&L2_0>;
			phandle = <0x08>;
			qcom,freq-domain = <&cpufreq_hw 0x00 0x07>;
			qcom,lmh-dcvs = <&lmh_dcvs0>;
			reg = <0x00 0x01>;

			L1_D_1: l1-dcache {
				compatible = "arm,arch-cache";
			};

			L1_I_1: l1-icache {
				compatible = "arm,arch-cache";
			};
		};

		CPU4: cpu@100 {
			#cooling-cells = <0x02>;
			capacity-dmips-mhz = <0x666>;
			compatible = "arm,armv8";
			device_type = "cpu";
			dynamic-power-coefficient = <0x11a>;
			enable-method = "psci";
			next-level-cache = <&L2_1>;
			phandle = <0x0b>;
			qcom,freq-domain = <&cpufreq_hw 0x01 0x07>;
			qcom,lmh-dcvs = <&lmh_dcvs1>;
			reg = <0x00 0x100>;

			L1_D_100: l1-dcache {
				compatible = "arm,arch-cache";
			};

			L1_I_100: l1-icache {
				compatible = "arm,arch-cache";
			};

			L2_1: l2-cache {
				cache-level = <0x02>;
				compatible = "arm,arch-cache";
				phandle = <0x05>;
			};
		};

		CPU5: cpu@101 {
			capacity-dmips-mhz = <0x666>;
			compatible = "arm,armv8";
			device_type = "cpu";
			dynamic-power-coefficient = <0x11a>;
			enable-method = "psci";
			next-level-cache = <&L2_1>;
			phandle = <0x0c>;
			qcom,freq-domain = <&cpufreq_hw 0x01 0x07>;
			qcom,lmh-dcvs = <&lmh_dcvs1>;
			reg = <0x00 0x101>;

			L1_D_101: l1-dcache {
				compatible = "arm,arch-cache";
			};

			L1_I_101: l1-icache {
				compatible = "arm,arch-cache";
			};
		};

		CPU6: cpu@102 {
			capacity-dmips-mhz = <0x666>;
			compatible = "arm,armv8";
			device_type = "cpu";
			dynamic-power-coefficient = <0x11a>;
			enable-method = "psci";
			next-level-cache = <&L2_1>;
			phandle = <0x0d>;
			qcom,freq-domain = <&cpufreq_hw 0x01 0x07>;
			qcom,lmh-dcvs = <&lmh_dcvs1>;
			reg = <0x00 0x102>;

			L1_D_102: l1-dcache {
				compatible = "arm,arch-cache";
			};

			L1_I_102: l1-icache {
				compatible = "arm,arch-cache";
			};
		};

		CPU7: cpu@103 {
			capacity-dmips-mhz = <0x666>;
			compatible = "arm,armv8";
			device_type = "cpu";
			dynamic-power-coefficient = <0x11a>;
			enable-method = "psci";
			next-level-cache = <&L2_1>;
			phandle = <0x0e>;
			qcom,freq-domain = <&cpufreq_hw 0x01 0x07>;
			qcom,lmh-dcvs = <&lmh_dcvs1>;
			reg = <0x00 0x103>;

			L1_D_103: l1-dcache {
				compatible = "arm,arch-cache";
			};

			L1_I_103: l1-icache {
				compatible = "arm,arch-cache";
			};
		};

		CPU2: cpu@2 {
			capacity-dmips-mhz = <0x400>;
			compatible = "arm,armv8";
			device_type = "cpu";
			dynamic-power-coefficient = <0x64>;
			enable-method = "psci";
			next-level-cache = <&L2_0>;
			phandle = <0x09>;
			qcom,freq-domain = <&cpufreq_hw 0x00 0x07>;
			qcom,lmh-dcvs = <&lmh_dcvs0>;
			reg = <0x00 0x02>;

			L1_D_2: l1-dcache {
				compatible = "arm,arch-cache";
			};

			L1_I_2: l1-icache {
				compatible = "arm,arch-cache";
			};
		};

		CPU3: cpu@3 {
			capacity-dmips-mhz = <0x400>;
			compatible = "arm,armv8";
			device_type = "cpu";
			dynamic-power-coefficient = <0x64>;
			enable-method = "psci";
			next-level-cache = <&L2_0>;
			phandle = <0x0a>;
			qcom,freq-domain = <&cpufreq_hw 0x00 0x07>;
			qcom,lmh-dcvs = <&lmh_dcvs0>;
			reg = <0x00 0x03>;

			L1_D_3: l1-dcache {
				compatible = "arm,arch-cache";
			};

			L1_I_3: l1-icache {
				compatible = "arm,arch-cache";
			};
		};
	};

	firmware: firmware {

		android {
			compatible = "android,firmware";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor,dtbo";
			};
		};
	};

	mem-offline {
		compatible = "qcom,mem-offline";
		granule = <0x200>;
		offline-sizes = <0x01 0x40000000 0x00 0x40000000>, <0x01 0xc0000000 0x00 0x80000000>, <0x02 0xc0000000 0x01 0x40000000>;
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	reserved_memory: reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		adsp_mem: adsp_region {
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			compatible = "shared-dma-pool";
			phandle = <0xd9>;
			reusable;
			size = <0x00 0x800000>;
		};

		pil_cdsp_mem: cdsp_regions@51a00000 {
			compatible = "removed-dma-pool";
			no-map;
			phandle = <0x7c>;
			reg = <0x00 0x51a00000 0x00 0x1e00000>;
		};

		cdsp_sec_mem: cdsp_sec_regions@46200000 {
			compatible = "removed-dma-pool";
			no-map;
			phandle = <0x10b>;
			reg = <0x00 0x46200000 0x00 0x1e00000>;
		};

		cont_splash_memory: cont_splash_region@5c000000 {
			label = "cont_splash_region";
			reg = <0x00 0x5c000000 0x00 0xf00000>;
		};

		dfps_data_memory: dfps_data_region@5cf00000 {
			label = "dfps_data_region";
			reg = <0x00 0x5cf00000 0x00 0x100000>;
		};

		disp_rdump_memory: disp_rdump_region@5c000000 {
			label = "disp_rdump_region";
			reg = <0x00 0x5c000000 0x00 0xf00000>;
		};

		pil_gpu_mem: gpu_region@56615000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x56615000 0x00 0x2000>;
		};

		hyp_mem: hyp_region@45700000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x45700000 0x00 0x600000>;
		};

		pil_ipa_fw_mem: ipa_fw_region@56600000 {
			compatible = "removed-dma-pool";
			no-map;
			phandle = <0xf6>;
			reg = <0x00 0x56600000 0x00 0x10000>;
		};

		pil_ipa_gsi_mem: ipa_gsi_region@56610000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x56610000 0x00 0x5000>;
		};

		linux,cma {
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			compatible = "shared-dma-pool";
			linux,cma-default;
			reusable;
			size = <0x00 0x2000000>;
		};

		dump_mem: mem_dump_region {
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			compatible = "shared-dma-pool";
			phandle = <0x7f>;
			reusable;
			size = <0x00 0x800000>;
		};

		pil_modem_mem: modem_region@4ab00000 {
			compatible = "removed-dma-pool";
			no-map;
			phandle = <0xeb>;
			reg = <0x00 0x4ab00000 0x00 0x6900000>;
		};

		pil_adsp_mem: pil_adsp_region@53800000 {
			compatible = "removed-dma-pool";
			no-map;
			phandle = <0x78>;
			reg = <0x00 0x53800000 0x00 0x2e00000>;
		};

		pil_video_mem: pil_video_region@51400000 {
			compatible = "removed-dma-pool";
			no-map;
			phandle = <0xea>;
			reg = <0x00 0x51400000 0x00 0x500000>;
		};

		qseecom_mem: qseecom_region {
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			compatible = "shared-dma-pool";
			phandle = <0x71>;
			reusable;
			size = <0x00 0x1400000>;
		};

		qseecom_ta_mem: qseecom_ta_region {
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			compatible = "shared-dma-pool";
			phandle = <0x10d>;
			reusable;
			size = <0x00 0x1000000>;
		};

		ramoops_mem: ramoops@5D000000 {
			compatible = "ramoops";
			console-size = <0x100000>;
			pmsg-size = <0x200000>;
			record-size = <0x80000>;
			reg = <0x00 0x5d000000 0x00 0x400000>;
		};

		removed_mem: removed_region@60000000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x60000000 0x00 0x3900000>;
		};

		sec_apps_mem: sec_apps_region@45fff000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x45fff000 0x00 0x1000>;
		};

		secure_display_memory: secure_display_region {
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			compatible = "shared-dma-pool";
			phandle = <0x10a>;
			reusable;
			size = <0x00 0x5c00000>;
		};

		smem_mem: smem_region@46000000 {
			compatible = "removed-dma-pool";
			no-map;
			phandle = <0xd7>;
			reg = <0x00 0x46000000 0x00 0x200000>;
		};

		user_contig_mem: user_contig_region {
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			compatible = "shared-dma-pool";
			phandle = <0x10c>;
			reusable;
			size = <0x00 0x1000000>;
		};

		wlan_msa_mem: wlan_msa_region@51900000 {
			compatible = "removed-dma-pool";
			no-map;
			phandle = <0xe6>;
			reg = <0x00 0x51900000 0x00 0x100000>;
		};

		xbl_aop_mem: xbl_aop_region@45e00000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x45e00000 0x00 0x140000>;
		};
	};

	soc: soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		compatible = "simple-bus";
		ranges = <0x00 0x00 0x00 0xffffffff>;

		ad_hoc_bus: ad-hoc-bus {
			compatible = "qcom,msm-bus-device";
			reg = <0x1880000 0x60200>, <0x4480000 0x80000>, <0x1900000 0x8200>, <0x1880000 0x60200>, <0x1880000 0x60200>, <0x1880000 0x60200>, <0x1880000 0x60200>;
			reg-names = "sys_noc-base", "bimc-base", "config_noc-base", "qup_virt-base", "fab-gpu_vert-base", "mmnrt_virt-base", "mmrt_virt-base";

			fab_bimc: fab-bimc {
				cell-id = <0x00>;
				clock-names = "bus_clk", "bus_a_clk";
				clocks = <&rpmcc 0x7b>, <&rpmcc 0x7c>;
				label = "fab-bimc";
				phandle = <0x110>;
				qcom,base-name = "bimc-base";
				qcom,bus-type = <0x02>;
				qcom,fab-dev;
				qcom,util-fact = <0x99>;
			};

			fab_config_noc: fab-config_noc {
				cell-id = <0x1400>;
				clock-names = "bus_clk", "bus_a_clk";
				clocks = <&rpmcc 0x92>, <&rpmcc 0x93>;
				label = "fab-config_noc";
				phandle = <0x134>;
				qcom,base-name = "config_noc-base";
				qcom,bus-type = <0x01>;
				qcom,bypass-qos-prg;
				qcom,fab-dev;
			};

			fab_gpu_vert: fab-gpu_vert {
				cell-id = <0x180f>;
				label = "fab-gpu_vert";
				phandle = <0x146>;
				qcom,base-name = "fab-gpu_vert-base";
				qcom,bus-type = <0x01>;
				qcom,bypass-qos-prg;
				qcom,vert-dev;
			};

			fab_mmnrt_virt: fab-mmnrt_virt {
				cell-id = <0x1810>;
				clock-names = "bus_clk", "bus_a_clk";
				clocks = <&rpmcc 0x96>, <&rpmcc 0x97>;
				label = "fab-mmnrt_virt";
				phandle = <0x142>;
				qcom,base-name = "mmnrt_virt-base";
				qcom,base-offset = <0x15000>;
				qcom,bus-type = <0x03>;
				qcom,fab-dev;
				qcom,qos-off = <0x1000>;
				qcom,util-fact = <0x8e>;
			};

			fab_mmrt_virt: fab-mmrt_virt {
				cell-id = <0x1811>;
				clock-names = "bus_clk", "bus_a_clk";
				clocks = <&rpmcc 0x9e>, <&rpmcc 0x9f>;
				label = "fab-mmrt_virt";
				phandle = <0x144>;
				qcom,base-name = "mmrt_virt-base";
				qcom,base-offset = <0x15000>;
				qcom,bus-type = <0x03>;
				qcom,fab-dev;
				qcom,qos-off = <0x1000>;
				qcom,util-fact = <0x8b>;
			};

			fab_qup_virt: fab-qup_virt {
				cell-id = <0x180e>;
				clock-names = "bus_clk", "bus_a_clk";
				clocks = <&rpmcc 0x0c>, <&rpmcc 0x0d>;
				label = "fab-qup_virt";
				phandle = <0x138>;
				qcom,base-name = "qup_virt-base";
				qcom,bus-type = <0x01>;
				qcom,bypass-qos-prg;
				qcom,fab-dev;
			};

			fab_sys_noc: fab-sys_noc {
				cell-id = <0x400>;
				clock-names = "bus_clk", "bus_a_clk";
				clocks = <&rpmcc 0x79>, <&rpmcc 0x7a>;
				label = "fab-sys_noc";
				phandle = <0x136>;
				qcom,base-name = "sys_noc-base";
				qcom,base-offset = <0x15000>;
				qcom,bus-type = <0x03>;
				qcom,fab-dev;
				qcom,qos-off = <0x1000>;
			};

			mas_anoc_snoc: mas-anoc-snoc {
				cell-id = <0xb5>;
				label = "mas-anoc-snoc";
				phandle = <0x14d>;
				qcom,agg-ports = <0x01>;
				qcom,bus-dev = <&fab_sys_noc>;
				qcom,buswidth = <0x10>;
				qcom,connections = <&slv_qxs_pimem&slv_qxs_imem&slv_qhs_apss&slv_snoc_bimc&slv_snoc_cnoc&slv_xs_sys_tcu_cfg&slv_xs_qdss_stm>;
				qcom,mas-rpm-id = <0x6e>;
			};

			mas_apps_proc: mas-apps-proc {
				cell-id = <0x01>;
				label = "mas-apps-proc";
				qcom,agg-ports = <0x01>;
				qcom,ap-owned;
				qcom,bus-dev = <&fab_bimc>;
				qcom,buswidth = <0x10>;
				qcom,connections = <&slv_ebi&slv_bimc_snoc>;
				qcom,mas-rpm-id = <0x00>;
				qcom,prio-lvl = <0x00>;
				qcom,prio-rd = <0x00>;
				qcom,prio-wr = <0x00>;
				qcom,qos-mode = "fixed";
				qcom,qport = <0x00>;
			};

			mas_bimc_snoc: mas-bimc-snoc {
				cell-id = <0x2720>;
				label = "mas-bimc-snoc";
				phandle = <0x147>;
				qcom,agg-ports = <0x01>;
				qcom,bus-dev = <&fab_sys_noc>;
				qcom,buswidth = <0x08>;
				qcom,connections = <&slv_qxs_pimem&slv_qxs_imem&slv_qhs_apss&slv_snoc_cnoc&slv_xs_sys_tcu_cfg&slv_xs_qdss_stm>;
				qcom,mas-rpm-id = <0x15>;
			};

			mas_crypto_c0: mas-crypto-c0 {
				cell-id = <0x37>;
				clock-names = "node_clk", "node_a_clk";
				clocks = <&rpmcc 0xae>, <&rpmcc 0xaf>;
				label = "mas-crypto-c0";
				phandle = <0x77>;
				qcom,agg-ports = <0x01>;
				qcom,ap-owned;
				qcom,bus-dev = <&fab_sys_noc>;
				qcom,buswidth = <0x08>;
				qcom,connections = <&slv_anoc_snoc>;
				qcom,mas-rpm-id = <0x17>;
				qcom,prio = <0x02>;
				qcom,qos-mode = "fixed";
				qcom,qport = <0x16>;
			};

			mas_gpu_cdsp_bimc: mas-gpu-cdsp-bimc {
				cell-id = <0xb4>;
				label = "mas-gpu-cdsp-bimc";
				phandle = <0x14e>;
				qcom,agg-ports = <0x01>;
				qcom,ap-owned;
				qcom,bus-dev = <&fab_bimc>;
				qcom,buswidth = <0x20>;
				qcom,connections = <&slv_ebi&slv_bimc_snoc>;
				qcom,mas-rpm-id = <0xa5>;
				qcom,qos-mode = "bypass";
				qcom,qport = <0x01>;
			};

			mas_qhm_qdss_bam: mas-qhm-qdss-bam {
				cell-id = <0x35>;
				label = "mas-qhm-qdss-bam";
				qcom,agg-ports = <0x01>;
				qcom,ap-owned;
				qcom,bus-dev = <&fab_sys_noc>;
