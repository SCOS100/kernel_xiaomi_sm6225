			qcom,codec-ext-clk-src = <0x02>;
			qcom,codec-lpass-clk-id = <0x30b>;
			qcom,codec-lpass-ext-clk-freq = <0x124f800>;
		};

		clock_audio_va_2: va_npl_clk {
			#clock-cells = <0x01>;
			compatible = "qcom,audio-ref-clk";
			phandle = <0x1a2>;
			qcom,codec-ext-clk-src = <0x0a>;
			qcom,codec-lpass-clk-id = <0x310>;
			qcom,codec-lpass-ext-clk-freq = <0x124f800>;
		};

		vdda_usb_ss_dp_core: vdda_usb_ss_dp_core {
			compatible = "regulator-fixed";
			enable-active-high;
			gpio = <&pm6125_gpios 0x01 0x00>;
			phandle = <0x109>;
			pinctrl-0 = <&usb_eldo9>;
			pinctrl-names = "default";
			regulator-max-microvolt = <0xd6d80>;
			regulator-min-microvolt = <0xd6d80>;
			regulator-name = "vdd_supply";
		};

		wakegic: wake-gic {
			#interrupt-cells = <0x03>;
			compatible = "qcom,mpm-gic-khaje", "qcom,mpm-gic";
			interrupt-controller;
			interrupt-parent = <&intc>;
			interrupts-extended = <&wakegic 0x00 0xc5 0x01>;
			phandle = <0x01>;
			qcom,num-mpm-irqs = <0x60>;
			reg = <0x45f01b8 0x1000>, <0xf111008 0x04>;
			reg-names = "vmpm", "ipc";
		};

		wakegpio: wake-gpio {
			#interrupt-cells = <0x02>;
			compatible = "qcom,mpm-gpio";
			interrupt-controller;
			interrupt-parent = <&intc>;
			phandle = <0x157>;
		};

		wsa881x_analog_clk: wsa_ana_clk {
			#clock-cells = <0x01>;
			compatible = "qcom,audio-ref-clk";
			phandle = <0x16b>;
			qcom,codec-ext-clk-src = <0x03>;
			qcom,codec-lpass-clk-id = <0x301>;
			qcom,codec-lpass-ext-clk-freq = <0x927c00>;
			status = "disable";
		};

		xiaomi_touch {
			compatible = "xiaomi-touch";
			status = "ok";
			touch,name = "xiaomi-touch";
		};
	};
};

#include "sm6225-xiaomi-spesn.dts"
