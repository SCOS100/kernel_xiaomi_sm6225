				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					funnel_turing_out_funnel_qatb: endpoint {
						phandle = <0x54>;
						remote-endpoint = <&funnel_qatb_in_funnel_turing>;
						source = <&turing_etm0>;
					};
				};

				port@1 {
					reg = <0x01>;

					funnel_turing_out_tpda5: endpoint {
						phandle = <0x4a>;
						remote-endpoint = <&tpda5_in_funnel_turing>;
					};
				};

				port@2 {
					reg = <0x00>;

					funnel_turing_in_tpdm_turing: endpoint {
						phandle = <0x19>;
						remote-endpoint = <&tpdm_turing_out_funnel_turing>;
						slave-mode;
					};
				};

				port@3 {
					reg = <0x01>;

					funnel_turing_in_tpdm_turing_llm: endpoint {
						phandle = <0xf7>;
						remote-endpoint = <&tpdm_turing_llm_out_funnel_turing>;
						slave-mode;
					};
				};

				port@4 {
					reg = <0x02>;

					funnel_turing_in_turing_etm0: endpoint {
						phandle = <0x1a>;
						remote-endpoint = <&turing_etm0_out_funnel_turing>;
						slave-mode;
					};
				};
			};
		};

