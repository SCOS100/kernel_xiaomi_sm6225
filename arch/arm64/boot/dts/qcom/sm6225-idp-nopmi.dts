		msm_gpu: qcom,kgsl-3d0@5900000 {
			#cooling-cells = <0x02>;
			clock-names = "core_clk", "rbbmtimer_clk", "iface_clk", "ahb_clk", "mem_clk", "gmu_clk", "smmu_vote", "apb_pclk";
			clocks = <&gpucc 0x0c>, <&gpucc 0x09>, <&gcc 0x12>, <&gpucc 0x03>, <&gcc 0x5a>, <&gpucc 0x06>, <&gpucc 0x0e>, <&rpmcc 0x08>;
